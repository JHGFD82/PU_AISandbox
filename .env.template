# Professor Configuration
# Define professors with their API keys
# Format: PROF_[ID]_NAME=Display Name
# Format: PROF_[ID]_KEY=Primary API Key
# Format: PROF_[ID]_BACKUP_KEY=Backup API Key

# Professor 1
PROF_1_NAME=Heller
PROF_1_KEY=your_heller_primary_key_here
PROF_1_BACKUP_KEY=your_heller_backup_key_here

# Professor 2
PROF_2_NAME=Smith
PROF_2_KEY=your_smith_primary_key_here
PROF_2_BACKUP_KEY=your_smith_backup_key_here

# Professor 3
PROF_3_NAME=Johnson
PROF_3_KEY=your_johnson_primary_key_here
PROF_3_BACKUP_KEY=your_johnson_backup_key_here

# Professor 4
PROF_4_NAME=Davis
PROF_4_KEY=your_davis_primary_key_here
PROF_4_BACKUP_KEY=your_davis_backup_key_here

# ── Alternate API endpoint keys ────────────────────────────────────────────────
# For each endpoint defined in apis.json, set the corresponding key here.
# Pattern: API_<UPPERCASE_NAME>_KEY=your_key
#
# Examples:
# API_DELLA_KEY=your_della_key_here
# API_MY_CLUSTER_KEY=your_cluster_key_here

# ── Web UI plugin (optional) ────────────────────────────────────────────────────
# Unlocks python main.py webui serve. Generate this by running:
#   python main.py webui set-passphrase
# Leave unset to run with no unlock gate at all (fine for a 127.0.0.1-only setup).
# WEBUI_PASSPHRASE_HASH=

# Keeps browser sessions signed-in across server restarts. Any long random
# string works — if left unset, a new one is generated each time the server
# starts, meaning everyone has to unlock again after a restart.
# WEBUI_SESSION_SECRET=

# ── Lab-shared settings (optional) ──────────────────────────────────────────────
# Point this at a settings.toml-format file synced across a lab (e.g. via
# Dropbox) to share runtime defaults — worker counts, font sizes, retry
# behavior — between everyone's installation. Merges between settings.toml
# (repo defaults) and settings.local.toml (still this machine's personal
# overrides, which still win). See src/settings.py for the full merge order.
# PU_SANDBOX_LAB_SETTINGS=
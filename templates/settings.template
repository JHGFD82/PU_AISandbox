# settings.template — the starting point for your own settings.toml file.
#
# You normally never copy this by hand: setup does it for you, into the
# folder you choose to keep your own files in. It's here for reference,
# and for anyone who'd rather write the file themselves.
#
# settings.toml holds this installation's own credentials and local identity:
# professor names/keys, optional feature secrets, alternate-endpoint API
# keys, and which other installations' usage data to include in reports.
# It is the one file in this project that should never be placed in a
# synced folder (Dropbox, iCloud, etc.) — if a value needs to move between
# machines, copy that one line by hand over a channel you trust.
#
# You can also build this file entirely from the command line instead of
# copying/editing it by hand — see `python main.py settings --help`.

# One table per person. The table name is their university netID — the
# username they sign in with. That netID is what identifies them everywhere:
# it selects their API key, names their usage file, and is what gets typed on
# the command line (`python main.py jh43 translate ...`).
#
# `name` is only ever shown to people — in reports, and in the web
# interface's person picker — so write it however reads best.
# Commented out on purpose: these are the shape to copy, not people. Left
# live, a brand-new installation would report two people configured who
# don't exist, with placeholder keys that fail at the first API call.
#
# The easy way to add someone is `python main.py settings add-professor`,
# which asks for each part and hides the keys as you type them.
#
# [professors.jh43]
# name = "Jeff Heller"
# key = "their_primary_key_here"
# backup_key = "their_backup_key_here"   # optional
#
# [professors.as12]
# name = "Alice Smith"
# key = "another_primary_key_here"
#
# Where somebody's usage is kept somewhere other than this computer — because
# they also work on another, or because several computers share one folder —
# name that folder here and their spending is counted from it.
#
# usage_path = "/Users/heller/Dropbox/Smith-Shared/data"
# usage_mode = "read-only"     # only add what is there to their spending
# usage_mode = "shared-write"  # also record work done here, one file per call,
#                              # so no two computers ever edit the same file

# ── Alternate API endpoint keys ────────────────────────────────────────────────
# For each [endpoints.<name>] entry you define in settings.default.toml,
# preferences.toml, or a shared settings file, set its key here.
# Example:
# [endpoints.my_cluster]
# key = "your_cluster_key_here"

# ── Web UI plugin (optional) ────────────────────────────────────────────────────
# Unlocks python main.py webui serve. Set this by running:
#   python main.py webui set-passphrase
# Leave unset to run with no unlock gate at all (fine for a 127.0.0.1-only setup).
# [webui]
# passphrase_hash = "..."
#
# Keeps browser sessions signed-in across server restarts. Any long random
# string works — if left unset, a new one is generated each time the server
# starts, meaning everyone has to unlock again after a restart. Set with:
#   python main.py settings set webui.session_secret --generate
# session_secret = "..."

# ── Shared settings (optional) ──────────────────────────────────────────────────
# Point this at a settings.toml-format file synced across a group of
# installations (e.g. via Dropbox) to share runtime defaults between them —
# handy if you manage several professors' installations yourself, or if a
# research group wants everyone using the same tuned settings. Merges
# between settings.default.toml (the package's defaults) and preferences.toml
# (still this machine's personal overrides, which still win). See
# src/settings.py for the full merge order.
# [shared_settings]
# path = "/path/to/shared-settings.toml"
# The name is up to you — the sandbox reads whatever path you give here,
# so call it after your group if that reads better.

# ── What this installation is called (optional) ────────────────────────────────
# Where a folder is shared between computers, every file written into it is
# named after the computer that wrote it, so it is clear where each came from
# and no two ever collide. Left unset, a name is worked out from this computer.
# The folders themselves are set on each person, above.
# [usage_sources]
# source_id = "toms-mac"

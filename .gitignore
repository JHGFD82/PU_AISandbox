# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/

# Records which extras folder this copy of the package was set up against —
# see src/paths.py. It describes one installation and must never travel to
# another; its absence is what tells a freshly downloaded package that it
# hasn't been set up yet.
.installation

# This installation's own credentials and local identity (professors,
# secrets, endpoint keys, external usage-data sources) — see .settings.template.
.settings
# Old file name, kept ignored too in case a leftover/backup copy exists
# (see scripts/migrate_config_to_settings.py)
.env
.env.local
.env.*.local
.envrc

# Local settings overrides (user-specific, not committed)
settings.local.toml

# Testing / coverage artifacts
.coverage
htmlcov/
coverage.xml
coverage.json
junit.xml
.pytest_cache/

# Local test folder
example_docs/

# Fonts - include folder and README but exclude font files
fonts/*
!fonts/README.md

# Model catalog - local copy with personal pricing is not tracked; use model_catalog.template.json as starting point
src/model_catalog.json

# External/remote usage-data source config - superseded by the
# [usage_sources] section in .settings (see scripts/migrate_config_to_settings.py);
# kept ignored in case a leftover/backup copy exists
data_sources.json

# Token usage - exclude token tracker files but keep directory structure
token_usage.json
data/token_usage_*.json
data/archives/*
data/usage_report.html
!data/README.md

# One-time backup made by scripts/migrate_usage_records.py before it edits
# anything — a full copy of real per-professor usage/billing data, same
# reason data/token_usage_*.json and data/archives/* above are excluded
data/_pre_migration_backup/

# Web UI plugin data - real conversation content and per-professor memory
# notes are local to this installation, not tracked
data/conversations/*
data/webui_memory/*

# Plugins — each plugin is a separately cloned/developed git repo.
# The plugins/ folder is committed (via .gitkeep) so it exists on a fresh
# clone; the contents of each plugin repo are not tracked by the main repo.
# plugins/prompt/ and plugins/webui/ are the exceptions: they ship with this
# repo (prompt as a reference implementation/template, webui as a built-in
# feature — see docs/webui-plugin-plan.md).
plugins/*
!plugins/.gitkeep
!plugins/prompt/
!plugins/translation/
!plugins/transcription/
!plugins/webui/

# External files
Presentation/

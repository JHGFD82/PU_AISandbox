# Specify filepatterns you want git to ignore.
.DS_Store

# Environment variables
.env
.env.local
.env.*.local

# Local settings overrides (user-specific, not committed)
settings.local.toml

# Local language code extensions (user-specific, not committed)
languages.toml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.idea/

# VS Code
.vscode/settings.json
.vscode/launch.json

# Local test folder
example_docs/

# Fonts - include folder and README but exclude font files
fonts/*
!fonts/README.md

# Model catalog - local copy with personal pricing is not tracked; use model_catalog.template.json as starting point
src/model_catalog.json

# Token usage - exclude token tracker files but keep directory structure
token_usage.json
data/token_usage_*.json
data/archives/*
data/usage_report.html
!data/README.md

# Coverage
.coverage
htmlcov/
coverage.xml
junit.xml

# OS
Thumbs.db

# Plugins — each plugin is a separately cloned/developed git repo.
# The plugins/ folder is committed (via .gitkeep) so it exists on a fresh
# clone; the contents of each plugin repo are not tracked by the main repo.
# plugins/prompt/ is the exception: it ships with this repo as a reference
# implementation and template for building new plugins.
plugins/*
!plugins/.gitkeep
!plugins/prompt/
!plugins/translation/

# External files
Presentation/